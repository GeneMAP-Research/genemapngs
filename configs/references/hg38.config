params { 
   /***************************************************************************************************
    *                                        GET GATK BUNDLES                                         *
    *  https://console.cloud.google.com/storage/browser/genomics-public-data/resources/broad/hg38/v0/ *
    ***************************************************************************************************/

    ref_dir = "/vast/awonkam1/resources/hg38/refgenome/"
    gatk_dir = "/vast/awonkam1/resources/hg38/gatkbundles/"
    fastaRef = "${params.ref_dir}/hg38.fa"
    dbsnp = "${params.gatk_dir}/dbsnp156_hg38.vcf.gz"
    indelsRef = "${params.gatk_dir}/Homo_sapiens_assembly38.known_indels.vcf.gz"
    hapmap = "${params.gatk_dir}/hapmap_3.3.hg38.vcf.gz"
    omniRef = "${params.gatk_dir}/1000G_omni2.5.hg38.vcf.gz"
    snpRef = "${params.gatk_dir}/1000G_phase1.snps.high_confidence.hg38.vcf.gz"
    gmpSnpRef = "${params.gatk_dir}/genemapwgs-phase2_hwkm2581_hg38_snps_high_confidence.vcf.gz"
    gmpIndelRef = "${params.gatk_dir}/genemapwgs-phase2_hwkm2581_hg38_indels_high_confidence.vcf.gz"
    annovarDB = '/vast/awonkam1/resources/hg38/annovardbs/'
    build = 'hg38'
}

