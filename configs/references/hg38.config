params { 
    /*********************************************************************************
    *                   GET GATK BUNDLES GOOGLE STORAGE PUBLIC URL                   *
    *  https://storage.googleapis.com/genomics-public-data/resources/broad/hg38/v0/  *
    *********************************************************************************/

    ref_dir = "https://storage.googleapis.com/genomics-public-data/resources/broad/hg38/v0/"
    gatk_dir = "${ref_dir}"
    fastaRef = "${params.ref_dir}Homo_sapiens_assembly38.fasta"
    dbsnp = "${params.gatk_dir}Homo_sapiens_assembly38.dbsnp138.vcf"
    indelsRef = "${params.gatk_dir}Homo_sapiens_assembly38.known_indels.vcf.gz"
    hapmap = "${params.gatk_dir}hapmap_3.3.hg38.vcf.gz"
    omniRef = "${params.gatk_dir}1000G_omni2.5.hg38.vcf.gz"
    snpRef = "${params.gatk_dir}1000G_phase1.snps.high_confidence.hg38.vcf.gz"
    mills = "${params.gatk_dir}Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    gmpSnpRef = "${params.gatk_dir}genemapwgs-phase2_hwkm2581_hg38_snps_high_confidence.vcf.gz"
    gmpIndelRef = "${params.gatk_dir}genemapwgs-phase2_hwkm2581_hg38_indels_high_confidence.vcf.gz"
    annovarDB = 'NULL'
    build = 'hg38'
}

